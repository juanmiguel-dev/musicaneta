{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musicaneta-player",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "musicaneta-audio-tracks",
      "preview_bucket_name": "musicaneta-audio-tracks-dev"
    }
  ],
  "vars": {
    "R2_PUBLIC_DOMAIN": "https://pub-xxxxxx.r2.dev"
  }
}
