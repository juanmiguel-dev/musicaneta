---
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Musicaneta | Reproductor de Audio Cloudflare R2',
  description = 'Reproductor multimedia moderno y rápido con Astro, Tailwind CSS y Cloudflare R2',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark bg-black text-zinc-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col pb-28 selection:bg-emerald-500 selection:text-black">
    {/* Header Navigation */}
    <header class="sticky top-0 z-40 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-900 px-6 py-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 text-emerald-400 font-bold text-xl tracking-tight">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
            <svg class="w-5 h-5 fill-current text-emerald-400" viewBox="0 0 24 24">
              <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"></path>
            </svg>
          </div>
          <span>Musicaneta<span class="text-xs ml-1 font-mono text-zinc-500 font-normal">R2</span></span>
        </a>

        <nav class="flex items-center space-x-6 text-sm font-medium">
          <a href="/" class="text-zinc-300 hover:text-emerald-400 transition-colors">
            Biblioteca
          </a>
          <a
            href="/upload"
            class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-lg text-emerald-400 font-semibold transition-all flex items-center space-x-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z"></path>
            </svg>
            <span>Subir MP3</span>
          </a>
        </nav>
      </div>
    </header>

    {/* Main Content View Container */}
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8">
      <slot />
    </main>

    {/* Persistent Audio Player (Isla cliente con transition:persist) */}
    <div transition:persist="audio-player-root">
      <AudioPlayer client:load />
    </div>
  </body>
</html>
