---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Musicaneta',
  description = 'Reproductor de Audio Minimalista y Futurista',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark bg-black text-zinc-100 antialiased h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="h-full bg-black text-zinc-100 selection:bg-white selection:text-black overflow-hidden">
    <main class="h-full w-full">
      <slot />
    </main>
  </body>
</html>
