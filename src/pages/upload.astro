---
import Layout from '../layouts/Layout.astro';
import UploadForm from '../components/UploadForm';
---

<Layout title="Subir Canción a Cloudflare R2 | Musicaneta">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-extrabold text-white">Cargar Música</h1>
        <p class="text-zinc-400 text-sm mt-1">
          Sube tus archivos MP3 directamente a Cloudflare R2 usando Presigned URLs.
        </p>
      </div>
      <a href="/" class="text-xs font-semibold text-zinc-400 hover:text-emerald-400 transition-colors">
        &larr; Volver a la Biblioteca
      </a>
    </div>

    {/* Formulario React con subida directa */}
    <UploadForm client:load />
  </div>
</Layout>
